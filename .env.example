# QWEN_API_KEY: Required for Qwen AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI or settings.
QWEN_API_KEY="MY_QWEN_API_KEY"
DASHSCOPE_API_KEY="MY_DASHSCOPE_API_KEY"

# AI_PROVIDER: Specifies the active AI provider model for the swarm operations.
# Supported values: gemini (default), qwen
AI_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_PROVIDER: Specifies the active database provider.
# Supported values: local (JSON file), firestore (Google Firestore)
DATABASE_PROVIDER="firestore"

# Firebase Cloud Database Parameters (automatically loaded if firebase-applet-config.json stands)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_FIRESTORE_DATABASE_ID=
